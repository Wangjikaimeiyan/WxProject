/* pages/login/login.wxss */
.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  /* 蓝白渐变背景 */
  background: linear-gradient(135deg, #667eea 0%, #e0e5ec 100%);
  box-sizing: border-box;
  padding: 60rpx 40rpx;
  position: relative;
}

/* Logo区域 */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  padding: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
  margin-bottom: 40rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.5);
}

.app-desc {
  font-size: 28rpx;
  color: #5a6c7d;
  font-weight: 300;
}

/* 登录按钮 */
.login-btn {
  width: 80%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  /* 蓝色渐变按钮 */
  background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%);
  color: #fff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-top: 40rpx;
  border: none;
  transition: all 0.3s ease;
}

.login-btn-hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  opacity: 0.9;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
}

/* 底部说明 */
.footer {
  margin-top: 80rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.footer-text {
  color: #7f8c8d;
}

.link {
  color: #667eea;
  margin: 0 4rpx;
  text-decoration: underline;
  text-decoration-color: #667eea;
}
