<wxs module="util">
  // 根据id查菜品
  function getDish(arr, id) {
    for (var i = 0; i < arr.length; i++) {
      if (arr[i].id == id) {
        return arr[i];
      }
    }
    return {};
  }
  module.exports = {
    getDish: getDish
  };
</wxs>

<view class="page-container">
  <view class="top-header">
    <view class="shop-row">
      <text class="shop-name">☆MJGA餐饮服务</text>
      <text class="shop-arrow"></text>
    </view>
    <view class="info-row">
      <text class="distance">⏰营业时间:6:00-20:00</text>
      <view class="mode-tag">
        <text wx:if="{{shopStatus === 1}}" class="mode-text active">✅营业中</text>
        <text wx:if="{{shopStatus === 0}}" class="mode-text active">❌停业中</text>
      </view>
    </view>
  </view>

  <!-- 中间主体：左分类 + 右菜品 -->
  <view class="main-body">
    <!-- 左侧菜品分类 -->
    <view class="category-sidebar">
      <!-- wx:for 循环渲染分类，wx:key 必须写 -->
      <view wx:for="{{categoryList}}" wx:key="id" class="cate-item {{activeCateId === item.id ? 'cate-active' : ''}}" bindtap="selectCate" data-id="{{item.id}}">
        <view class="cate-item">
          <text class="cate-text">{{item.name}}</text>
        </view>
      </view>
    </view>


    <!-- 右侧菜品卡片区 -->
    <scroll-view class="goods-panel" scroll-y>
      <!-- 菜品卡片，循环渲染 goodsList -->
      <view class="goods-card" wx:for="{{AllDishes}}" wx:key="id" wx:if="{{item.category === activeCateId}}">
        <image class="goods-img" src="{{item.image}}"></image>
        <view class="goods-info">
          <view class="goods-name">
            <view>{{item.name}}</view>
            <view class="sales-text">总销量{{item.sales}}</view>
          </view>
          <view class="goods-desc">{{item.detail}}</view>
          <view class="goods-price">¥{{item.price}}</view>
        </view>
        <view class="goods-ctrl">
          <view class="goods-min" bindtap="onMinCart" data-dish="{{item}}">-</view>
          <view class="goods-num">{{dishid_counts[item.id]||0}}</view>
          <view class="goods-add" bindtap="onAddCart" data-dish="{{item}}">+</view>
        </view>
      </view>


    </scroll-view>


  </view>

  <!-- 底部购物车（固定） -->
  <view class="bottom-cart" bindtap="toggleCartDetail">
    <view class="cart-icon-wrap">
      <view class="cart-icon">🛒</view>
      <!-- 角标可自行添加 -->
    </view>
    <view class="cart-info">
      <text class="cart-total">¥{{cart_total_price}}</text>
      <text class="cart-tip">预估配送约30分钟</text>
    </view>
    <!-- 可点击：状态1 -->
    <view wx:if="{{shopStatus === 1}}" class="cart-btn active1" catchtap="ordertoinput">
      去结算
    </view>

    <!-- 不可点击：状态0 -->
    <view wx:else class="cart-btn disabled" catchtap="order1">
      暂不接单
    </view>

  </view>
</view>
<!-- 购物车详情浮层 -->
<view class="cart-detail-fixed {{showCartDetail ? 'show' : ''}}">
  <!-- 固定顶部标题：永远在最上面，不滚动 -->
  <view class="cart-detail-title">购物车详情</view>

  <!-- 滚动区域：只有菜品内容滚动 -->
  <view class="cart-scroll-box">
    <view class="goods-card" wx:for="{{dishid_counts}}" wx:for-of wx:key="*this">
      <image class="goods-img" src="{{util.getDish(AllDishes, index).image}}"></image>
      <view class="goods-info">
        <view class="goods-name">{{util.getDish(AllDishes, index).name}}</view>
        <view class="goods-desc">{{util.getDish(AllDishes, index).detail}}</view>
        <view class="goods-price">¥{{util.getDish(AllDishes, index).price}}</view>
      </view>
      <view class="goods-ctrl">
        <view class="goods-min" bindtap="onMinCart" data-dish="{{util.getDish(AllDishes, index)}}">-</view>
        <view class="goods-num">{{item}}</view>
        <view class="goods-add" bindtap="onAddCart" data-dish="{{util.getDish(AllDishes, index)}}">+</view>
      </view>
    </view>
  </view>
</view>

<!-- 订单输入框 -->
<!-- 备注弹窗 -->
<view wx:if="{{showRemarkPopup}}" class="popup-mask" catchtap="closePopup">
  <view class="popup-box" catchtap="stopTap">
    <view class="popup-title">订单备注</view>
    <textarea placeholder="选填：口味要求、不要香菜等" bindinput="remarkInput" value="{{order_remark}}"></textarea>
    <view class="popup-btns">
      <button bindtap="closePopup">取消</button>
      <button bindtap="order">确认下单</button>
    </view>
  </view>
</view>
