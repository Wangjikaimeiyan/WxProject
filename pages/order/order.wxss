/* ===== 页面整体布局 ===== */
/* 关键：固定页面高度，禁止页面整体滚动 */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* ===== 顶部标题栏 ===== */
.top-header {
  width: 100%;
  height: 6vh;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 3rpx solid #616161;
  box-sizing: border-box;

  /* 新增以下两行 */
  flex-shrink: 0;          /* 绝对禁止被弹性容器压缩 */
  will-change: transform;  /* 提升到独立合成层，避免重绘抖动 */
}
.shop-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

/* ===== 分类标签栏 ===== */
.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 6vh;
  background: #fff;
  /* 固定大小 */
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
  font-size: 28rpx;
  color: #666;
}
.tab-active {
  color: #ff6b00;
  font-weight: 600;
}
.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #ff6b00;
  border-radius: 3rpx;
}

/* ===== 订单列表可滚动区域 ===== */
.order-list {
  /* 移除 flex: 1; 改用固定计算高度，确保不被撑开 */
  height: calc(100vh);   /* 总屏幕高度 - 标题栏(6vh) - 标签栏(6vh) */
  padding: 20rpx;
  box-sizing: border-box;
  overflow-y: auto;            /* scroll-view 会自动处理，但加上保证兼容 */
}

/* ========== 订单卡片整体 ========== */
.order-card {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  /* 卡片大小由内容撑开，不固定高度 */
}

/* 极浅灰色分割线（1px） */
.divider {
  height: 1rpx;
  background-color: #eeeeee;
}

/* 菜品之间较淡的分割线 */
.divider-light {
  height: 1rpx;
  background-color: #f5f5f5;
}

/* ===== ① 顶部状态栏（固定大小） ===== */
.card-header {
  /* 【可调】以下属性构成固定高度，可调整 padding 和行高来控制 */
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;    /* 【可调】固定内边距 */
  min-height: 80rpx;       /* 【可调】最小高度保证统一 */
  box-sizing: border-box;
}
.restaurant-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.order-status {
  font-size: 28rpx;
  color: #ff6b00;          /* 状态文字颜色，可根据状态改变 */
}

/* ===== ② 单个菜品小卡片 ===== */
.food-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

/* 左边菜品图片 – 强制正方形，尺寸按需调整 */
.food-img {
  width: 120rpx;           /* 【可调】正方形边长 */
  height: 120rpx;          /* 必须与 width 一致保证正方形 */
  border-radius: 8rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;          /* 防止被压缩 */
}
/* 如有不同尺寸图片，mode="aspectFill" 会居中裁剪，确保显示为正方形 */

/* 中间菜品名称 */
.food-name {
  flex: 1;
  padding: 0 20rpx;
  font-size: 28rpx;
  font-weight: 550;
  color: #333;
  font-family: "Microsoft YaHei", "PingFang SC", sans-serif;  /* 微软雅黑备选 */
  align-self: start;
}

/* 右边单价+数量容器 */
.food-price {
  align-self: start;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
}
.price-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.quantity-text {
  font-size: 22rpx;        /* 较小，约等于9pt */
  color: #999;
  margin-top: 4rpx;
}

/* ===== ③ 备注与总价 ===== */
.remark-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}
.remark-text {
  font-size: 26rpx;
  color: #888;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #000;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ===== ④ 底部操作按钮区域 ===== */
.card-footer {
  display: flex;
  justify-content: flex-end;   /* 按钮靠右 */
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

/* 通用 button 样式重置（去掉默认边框和圆角） */
.card-footer button {
  margin: 0;
  padding: 12rpx 30rpx;
  font-size: 28rpx;
  border-radius: 36rpx;
  box-sizing: border-box;
  line-height: 1.4;
  border: none;
}

/* 去支付按钮 */
.btn-pay {
  background: #ff4444;
  color: #fff;
}

/* 取消订单按钮 */
.btn-cancel {
  background: #fff;
  color: #333;
  border: 2rpx solid #ccc !important;
}

/* 待处理状态的提示文字 */
.status-text {
  font-size: 28rpx;
  color: #999;
  width: 100%;
  text-align: right;
}

/* 已完成状态 – 删除订单 */
.btn-delete {
  background: #fff;
  color: #333;
  border: 2rpx solid #ccc !important;
}

/* 已完成状态 – 售后服务 */
.btn-service {
  background: #fff;
  color: #ff0000;
  border: 2rpx solid #000 !important;
  font-weight: 600;
}
